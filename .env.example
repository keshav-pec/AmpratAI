# AmpratAI works fully without any of this — progress is saved in your browser.
#
# Set these only if you want your progress to follow you across devices.
# 1. Make a free cluster at https://www.mongodb.com/cloud/atlas
# 2. Paste the connection string below
# 3. Pick any long random string for the token, and use the same one on every device
MONGODB_URI=
AMPRAT_SYNC_TOKEN=
